


import os
import re
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# Define workspace directories
workspace_dir = "simulation_workspace"
os.makedirs(workspace_dir, exist_ok=True)
print(f"Simulation workspace initialized at: {workspace_dir}/")






# Range settings mirroring the experimental bash sequence (4.0 to 4.1 with 0.0025 increments)
lattice_constants = np.arange(4.00, 4.1025, 0.0025)

# Array to consolidate the parsed outputs
parsed_results = []

for a in lattice_constants:
    input_filename = os.path.join(workspace_dir, f"in.al_opt_{a:.4f}")
    log_filename = os.path.join(workspace_dir, f"log.al_opt_{a:.4f}")
    
    # Construction of the raw input script based on lab directives
    lammps_script_content = f"""# INITIALIZATION
clear
units metal
dimension 3
boundary p p p
atom_style atomic
atom_modify map array

# ATOM DEFINITION
lattice fcc {a:.4f} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region box block 0 1 0 1 0 1 units lattice
create_box 1 box
create_atoms 1 box
replicate 1 1 1

# DEFINE INTERATOMIC POTENTIAL
pair_style eam/alloy
pair_coeff * * Al99.eam.alloy Al
neighbor 2.0 bin
neigh_modify delay 10 check yes

# DEFINE COMPUTES & VARIABLES
compute eng all pe/atom
compute eatoms all reduce sum c_eng

variable natoms equal "count(all)"
variable teng equal "c_eatoms"
variable length equal "lx"
variable ecoh equal "v_teng/v_natoms"

# RUN MINIMIZATION
reset_timestep 0
thermo 10
thermo_style custom step pe press c_eatoms v_ecoh etotal
min_style cg
minimize 1e-25 1e-25 5000 10000

print "DATA_CAPTURE: LatConst = {a:.4f} | FinalPE = ${{teng}} | Press = ${{press}} | Ecoh = ${{ecoh}}"
"""
    
    # Write input file to disk
    with open(input_filename, "w") as f:
        f.write(lammps_script_content)

print(f"Successfully generated {len(lattice_constants)} distinct automated LAMMPS input matrices.")






# Iterative execution and advanced string regex parsing mapping to memory arrays
for a in lattice_constants:
    input_file = os.path.join(workspace_dir, f"in.al_opt_{a:.4f}")
    log_file = os.path.join(workspace_dir, f"log.al_opt_{a:.4f}")
    
    # Call the binary shell command
    os.system(f"lmp -in {input_file} > {log_file}")
    
    # Advanced extraction replacing legacy grep/awk routines
    if os.path.exists(log_file):
        with open(log_file, "r") as lf:
            log_content = lf.read()
            match = re.search(r"DATA_CAPTURE: LatConst = ([\d\.]+) \| FinalPE = ([\-\d\.]+) \| Press = ([\-\d\.]+) \| Ecoh = ([\-\d\.]+)", log_content)
            if match:
                parsed_results.append({
                    "Lattice_Constant": float(match.group(1)),
                    "Total_PE_eV": float(match.group(2)),
                    "Pressure_Bars": float(match.group(3)),
                    "Cohesive_Energy_eV_atom": float(match.group(4))
                })

# Convert list array directly into a scalable Pandas DataFrame
df = pd.DataFrame(parsed_results)
df.to_csv("simulation_outputs.csv", index=False)
df.head(5)






# Initialize dual structural graph visualization layout
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))

# Plot 1: Energy Landscapes (Lattice Parameter vs Cohesive Energy)
ax1.plot(df["Lattice_Constant"], df["Cohesive_Energy_eV_atom"], color="#2c3e50", marker='o', linewidth=2, label="EAM Simulated Curve")
ax1.set_xlabel("Lattice Parameter ($\AA$)", fontsize=12)
ax1.set_ylabel("Cohesive Energy ($eV/atom$)", fontsize=12)
ax1.set_title("Equation of State: Energy-Volume Coordinate Matrix", fontsize=13, fontweight='bold')
ax1.grid(True, linestyle='--', alpha=0.6)
ax1.legend()

# Plot 2: Pressure Discontinuities (Lattice Parameter vs Pressure)
ax2.plot(df["Lattice_Constant"], df["Pressure_Bars"], color="#e74c3c", marker='s', linewidth=2, label="System Internal Pressure")
ax2.axhline(0, color='black', linestyle=':', alpha=0.7) # Equilibrium line
ax2.set_xlabel("Lattice Parameter ($\AA$)", fontsize=12)
ax2.set_ylabel("Pressure (Bars)", fontsize=12)
ax2.set_title("Pressure Equilibrium Structural Response Curve", fontsize=13, fontweight='bold')
ax2.grid(True, linestyle='--', alpha=0.6)
ax2.legend()

plt.tight_layout()
plt.show()







